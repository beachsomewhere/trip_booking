# ---------------------------------------------------------------------------
# Supabase
# Local dev: run `supabase start` and copy the values it prints.
# Production: Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ — it bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site URL — drives magic-link and invite-link redirects.
# Must match the host people actually browse, or invite links point at the
# wrong place. Set this to the Vercel production URL in Vercel's env settings.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Places.
#
# Enable exactly ONE API on the GCP project: "Places API (New)". Not the legacy
# "Places API", and no Maps SDK -- this app renders no map. It calls three
# endpoints: places:autocomplete, places/{id}, and places:searchNearby.
#
# Server-only. Every call, photos included, is proxied through /api/places/*,
# so the key never reaches the browser. Restrict it to Places API (New); leave
# application restrictions as "None", since a referrer cannot match a
# server-side call and Vercel's egress IPs are not fixed.
#
# Optional: without it, place fields degrade to plain text and the whole app
# still works end to end.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Resend — transactional invite email.
# Leave RESEND_API_KEY empty in local dev: the app falls back to logging the
# invite URL to the server console so you can test without sending mail.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Trip Booker <onboarding@resend.dev>"
